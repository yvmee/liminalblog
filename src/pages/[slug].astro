---
import type { GetStaticPaths } from "astro"
import { render } from "astro:content"

import AuthorBio from "../components/AuthorBio.astro"
import Breadcrumbs from "../components/Breadcrumbs.astro"
import { CategoryBadge } from "../components/CategoryBadge.tsx"
import ImageFigure from "../components/ImageFigure.astro"
import { Flame } from "../components/Lantern.tsx"
import LanternDivider from "../components/LanternDivider.astro"
import { PostCard } from "../components/PostCard.tsx"
import {
  MechanicsBreakdown,
  ResearchCallout,
} from "../components/ResearchCallout.tsx"
import { ReviewVerdictBox } from "../components/ReviewVerdictBox.tsx"
import { ScaredyBadge } from "../components/ScaredyBadge.tsx"
import { ScoreBadge } from "../components/ScoreBadge.tsx"
import TableOfContents from "../components/TableOfContents.astro"
import YouTubeEmbed from "../components/YouTubeEmbed.astro"
import { author, categories, reviewItemType, site } from "../config/site.ts"
import BaseLayout from "../layouts/BaseLayout.astro"
import { formatDate, isoDate } from "../lib/format.ts"
import { absoluteUrl, asset, categoryHref, href } from "../lib/paths.ts"
import {
  getPosts,
  readingTime,
  relatedPosts,
  toCard,
  type Post,
} from "../lib/posts.ts"
import {
  articleSchemas,
  breadcrumbSchema,
  graph,
  personSchema,
  websiteSchema,
} from "../lib/schema.ts"

export const getStaticPaths = (async () => {
  const posts = await getPosts()
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post, all: posts },
  }))
}) satisfies GetStaticPaths

interface Props {
  post: Post
  all: Post[]
}

const { post, all } = Astro.props
const { data } = post
const { Content, headings } = await render(post)
const category = categories[data.category]
const minutes = readingTime(post.body)
const wordCount = (post.body ?? "").split(/\s+/).filter(Boolean).length
const related = relatedPosts(post, all).map(toCard)

const crumbs = [
  { name: "Portfolio", href: site.portfolioUrl },
  { name: "Blog", href: href("/") },
  { name: category.label, href: categoryHref(data.category) },
  { name: data.title },
]
const jsonLd = graph(
  ...articleSchemas(post, wordCount),
  breadcrumbSchema(
    crumbs.map((c) => ({
      name: c.name,
      url: c.href
        ? new URL(c.href, Astro.site).toString()
        : absoluteUrl(`/${post.id}/`),
    }))
  ),
  personSchema(),
  websiteSchema()
)

// MDX can use these without importing them
const components = {
  ResearchCallout,
  MechanicsBreakdown,
  ImageFigure,
  YouTubeEmbed,
}
---

<BaseLayout
  title={data.title}
  description={data.description}
  path={`/${post.id}/`}
  image={data.coverImage}
  imageAlt={data.coverImageAlt}
  type="article"
  publishedTime={data.pubDate}
  modifiedTime={data.updatedDate}
  section={category.label}
  tags={data.tags}
  jsonLd={jsonLd}
  noindex={data.draft}
>
  <!-- Reading progress: a flame walking along the bottom of the nav -->
  <div
    slot="nav"
    aria-hidden="true"
    class="pointer-events-none absolute inset-x-0 -bottom-0.5 h-0.5"
  >
    <div
      id="progress"
      class="relative h-full w-0 bg-gradient-to-r from-ember to-lantern opacity-0"
    >
      <Flame scale={1.5} flicker className="absolute -top-3 -right-1" />
    </div>
  </div>

  <article id="post" class="mx-auto max-w-6xl px-4 pt-8 sm:px-6">
    <Breadcrumbs items={crumbs} />

    <header class="mx-auto flex max-w-3xl flex-col gap-6 pt-10 pb-10 text-center">
      <div class="flex flex-wrap items-center justify-center gap-2">
        <a href={categoryHref(data.category)} class="hover:brightness-125">
          <CategoryBadge category={data.category} label={category.label} />
        </a>
        {data.draft && (
          <span class="rounded-sm bg-blood px-2 py-0.5 font-mono text-xs text-void">
            DRAFT
          </span>
        )}
      </div>
      <h1 class="font-serif text-4xl leading-[1.08] font-medium tracking-tight text-balance text-ink sm:text-5xl lg:text-6xl">
        {data.title}
      </h1>
      <p class="font-serif text-xl leading-relaxed text-balance text-muted">
        {data.description}
      </p>
      <div class="flex flex-wrap items-center justify-center gap-x-3 gap-y-2 font-mono text-xs text-faint">
        <span>
          By{" "}
          <a
            href={site.portfolioUrl}
            rel="author"
            class="text-muted hover:text-lantern"
          >
            {author.name}
          </a>
        </span>
        <span aria-hidden="true">·</span>
        <time datetime={isoDate(data.pubDate)}>{formatDate(data.pubDate)}</time>
        {data.updatedDate && (
          <>
            <span aria-hidden="true">·</span>
            <span>
              Updated{" "}
              <time datetime={isoDate(data.updatedDate)}>
                {formatDate(data.updatedDate)}
              </time>
            </span>
          </>
        )}
        <span aria-hidden="true">·</span>
        <span>{minutes} min read</span>
      </div>
      {data.review && (
        <a
          href="#verdict"
          class="group mx-auto flex items-center gap-3 rounded-sm border-2 border-border-strong bg-surface px-4 py-2 transition-colors hover:border-lantern"
        >
          <span class="flex flex-col items-start gap-1.5">
            {data.review.score !== undefined && (
              <ScoreBadge score={data.review.score} />
            )}
            {data.review.scaredyScore !== undefined && (
              <ScaredyBadge score={data.review.scaredyScore} />
            )}
          </span>
          <span class="text-left text-sm text-muted group-hover:text-ink">
            {data.review.subjectTitle} · {data.review.horrorSubgenre}
            <span class="block font-mono text-xs text-faint">
              Jump to verdict ↓
            </span>
          </span>
        </a>
      )}
    </header>

    <figure class="mx-auto max-w-5xl">
      <img
        src={asset(data.coverImage)}
        alt={data.coverImageAlt}
        width="1200"
        height="630"
        fetchpriority="high"
        class="pixel-shadow w-full rounded-md border-2 bg-void"
      />
    </figure>

    <div class="mx-auto mt-12 grid max-w-5xl gap-10 lg:grid-cols-[minmax(0,1fr)_14rem] lg:gap-14">
      <aside class="lg:order-2">
        <div class="lg:sticky lg:top-24">
          <TableOfContents headings={headings} hasVerdict={!!data.review} />
        </div>
      </aside>

      <div class="flex min-w-0 flex-col gap-14 lg:order-1">
        <div class="prose-horror drop-cap">
          <Content components={components} />
        </div>

        {data.review && (
          <ReviewVerdictBox
            review={data.review}
            creatorLabel={
              reviewItemType(data.category) === "Movie"
                ? "Director"
                : "Developer"
            }
            rubricHref={href("/press/#scoring")}
          />
        )}

        {data.tags.length > 0 && (
          <div class="flex flex-wrap items-center gap-2">
            <span class="eyebrow mr-1">Tagged</span>
            {data.tags.map((tag) => (
              <a
                href={`${href("/")}?q=${encodeURIComponent(tag)}#archive`}
                class="rounded-xs bg-raised px-2 py-0.5 font-mono text-xs text-muted hover:text-lantern"
              >
                #{tag}
              </a>
            ))}
          </div>
        )}

        <AuthorBio />
      </div>
    </div>
  </article>

  {related.length > 0 && (
    <section
      aria-labelledby="related-title"
      class="mx-auto mt-20 flex max-w-6xl flex-col gap-8 px-4 sm:px-6"
    >
      <LanternDivider label="Further into the dark" id="related-title" />
      <ul class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {related.map((card) => (
          <li class="flex">
            <PostCard post={card} className="flex-1" />
          </li>
        ))}
      </ul>
    </section>
  )}
</BaseLayout>

<script>
  const bar = document.getElementById("progress")
  const article = document.getElementById("post")
  if (bar && article) {
    const update = () => {
      const { top, height } = article.getBoundingClientRect()
      const progress = Math.min(1, Math.max(0, -top / (height - innerHeight)))
      bar.style.width = `${progress * 100}%`
      bar.style.opacity = progress > 0 ? "1" : "0"
    }
    addEventListener("scroll", update, { passive: true })
    update()
  }
</script>
