---
/**
 * Every page's <head> metadata: title, description, canonical, OpenGraph,
 * Twitter/Bluesky cards, feeds and JSON-LD.
 */
import { author, site } from "../config/site.ts"
import { absoluteUrl, asset } from "../lib/paths.ts"
import type { JsonLd } from "../lib/schema.ts"

interface Props {
  title: string
  description: string
  /** Root-relative path of this page; defaults to the current URL */
  path?: string
  /** Root-relative image path (base added automatically) */
  image?: string
  imageAlt?: string
  type?: "website" | "article" | "profile"
  publishedTime?: Date
  modifiedTime?: Date
  section?: string
  tags?: string[]
  jsonLd?: JsonLd
  noindex?: boolean
}

const {
  title,
  description,
  path,
  image = site.defaultOgImage,
  imageAlt = site.defaultOgImageAlt,
  type = "website",
  publishedTime,
  modifiedTime,
  section,
  tags = [],
  jsonLd,
  noindex = false,
} = Astro.props

const fullTitle =
  title === site.name
    ? `${site.name} · ${site.tagline}`
    : `${title} · ${site.name}`
const canonical = path
  ? absoluteUrl(path)
  : new URL(Astro.url.pathname, Astro.site).toString()
const imageUrl = absoluteUrl(image)
---

<title>{fullTitle}</title>
<meta name="description" content={description} />
{!noindex && <link rel="canonical" href={canonical} />}
<meta name="author" content={author.name} />
<meta
  name="robots"
  content={
    noindex ? "noindex, follow" : "index, follow, max-image-preview:large"
  }
/>
<meta name="generator" content={Astro.generator} />

<meta property="og:site_name" content={site.name} />
<meta property="og:locale" content={site.locale} />
<meta property="og:type" content={type} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
{!noindex && <meta property="og:url" content={canonical} />}
<meta property="og:image" content={imageUrl} />
<meta property="og:image:alt" content={imageAlt} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
{publishedTime && (
  <meta
    property="article:published_time"
    content={publishedTime.toISOString()}
  />
)}
{modifiedTime && (
  <meta property="article:modified_time" content={modifiedTime.toISOString()} />
)}
{type === "article" && (
  <meta property="article:author" content={site.portfolioUrl} />
)}
{section && <meta property="article:section" content={section} />}
{tags.map((tag) => (
  <meta property="article:tag" content={tag} />
))}

<!-- Twitter/X and Bluesky both read these -->
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={imageUrl} />
<meta name="twitter:image:alt" content={imageAlt} />

<link
  rel="alternate"
  type="application/rss+xml"
  title={`${site.name} RSS`}
  href={absoluteUrl("/rss.xml")}
/>
<link rel="sitemap" href={asset("/sitemap-index.xml")} />

{jsonLd && (
  <script
    type="application/ld+json"
    is:inline
    set:html={JSON.stringify(jsonLd)}
  />
)}
